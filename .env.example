# Copy to .env and adjust. Never commit .env.

# Which compose files `docker compose` uses by default.
#   Local dev: docker-compose.yml:docker-compose.dev.yml
#   VPS:       docker-compose.yml:docker-compose.vps.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# --- PostgreSQL ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me        # strong value on the VPS; letters/digits only (used in a URL)
POSTGRES_DB=sentinel

# --- Host ports (change if they clash) ---
SENTINEL_API_PORT=8000             # API is published on 127.0.0.1 only
POSTGRES_PORT=5432
REDPANDA_PORT=19092
REDIS_PORT=6379

# --- Reconciliation timing (seconds) ---
SENTINEL_MISSING_SETTLEMENT_SECONDS=86400   # lower (e.g. 60) for demos
SENTINEL_RECONCILIATION_GRACE_SECONDS=300
SENTINEL_SCHEDULER_INTERVAL_SECONDS=30

# --- OpenRouter (LLM investigator and embeddings) ---
OPENROUTER_API_KEY=
# mock = deterministic offline investigator; openrouter = real LLM (needs the key).
SENTINEL_INVESTIGATOR=mock
SENTINEL_LLM_MODEL=openai/gpt-4o-mini
# fake = deterministic offline embeddings; openrouter = real embeddings (needs the key).
# Changing it re-embeds the knowledge base on the next `make up`.
SENTINEL_EMBEDDER=fake
SENTINEL_EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Investigation workflow ---
SENTINEL_LEASE_SECONDS=60
SENTINEL_MAX_ATTEMPTS=3                 # then FAILED + dead letter
SENTINEL_RETRY_BACKOFF_SECONDS=5        # base of exponential backoff between attempts
SENTINEL_WORKER_CONCURRENCY=4           # investigations in parallel per worker process
SENTINEL_LLM_RATE_PER_SECOND=20         # shared across all workers (Redis token bucket)
# Simulate a provider failure on every LLM call: timeout, http_429, http_500,
# malformed, empty, slow. Empty = off.
SENTINEL_LLM_FAULT=
# Crash the worker after a step on an investigation's first attempt (spec §21), e.g.
# LLM_RESPONSE, KNOWLEDGE_RETRIEVED, RESULT_VERIFIED. Empty = disabled.
FAIL_AFTER_STEP=

# --- Application settings when running the app on the host (outside compose) ---
SENTINEL_ENVIRONMENT=local
SENTINEL_LOG_LEVEL=INFO
SENTINEL_DATABASE_URL=postgresql+asyncpg://sentinel:change-me@localhost:5432/sentinel
SENTINEL_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
SENTINEL_REDIS_URL=redis://localhost:6379/0
