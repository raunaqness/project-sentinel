# Copy to .env and adjust. Never commit .env.

# Which compose files `docker compose` uses by default.
#   Local dev: docker-compose.yml:docker-compose.dev.yml
#   VPS:       docker-compose.yml:docker-compose.vps.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# --- PostgreSQL ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me        # strong value on the VPS; letters/digits only (used in a URL)
POSTGRES_DB=sentinel

# --- Host ports (change if they clash) ---
SENTINEL_API_PORT=8000             # API is published on 127.0.0.1 only
POSTGRES_PORT=5432
REDPANDA_PORT=19092
REDIS_PORT=6379

# --- Reconciliation timing (seconds) ---
SENTINEL_MISSING_SETTLEMENT_SECONDS=86400   # lower (e.g. 60) for demos
SENTINEL_RECONCILIATION_GRACE_SECONDS=300
SENTINEL_SCHEDULER_INTERVAL_SECONDS=30

# --- Application settings when running the app on the host (outside compose) ---
SENTINEL_ENVIRONMENT=local
SENTINEL_LOG_LEVEL=INFO
SENTINEL_DATABASE_URL=postgresql+asyncpg://sentinel:change-me@localhost:5432/sentinel
SENTINEL_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
SENTINEL_REDIS_URL=redis://localhost:6379/0
